{
	"compilerOptions": {
	  "module": "ESNext",
	  "target": "ESNext",
	  "moduleResolution": "bundler",
	  "outDir": "./lib",
	  "rootDir": "./src/lib",
	  "esModuleInterop": true,
	  "strict": true,
	  "skipLibCheck": true,
	  "declaration": true, 
	},
	"include": ["src/lib/v2/*", "src/lib/ui/*", "src/lib/ui/components/*"],
	"exclude": ["node_modules"]
  }